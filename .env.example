# Template only: copy to .env.local for local dev. Real values live in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (project ucjnajvgpxsijzpaigpm). The anon/publishable key is public by design; the service role key is secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used for auth redirects and estimate links (default https://www.letstaystacked.com)
NEXT_PUBLIC_SITE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Anthropic (AI chat, receipt scan, AI pricing, voice parse)
ANTHROPIC_API_KEY=

# Resend (transactional email). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="StackedWork <notifications@letstaystacked.com>"
